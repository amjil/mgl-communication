(ns mgl.call.signaling
  "Signaling abstraction aligned with mgl-realtime-server WS protocol.

   Transport map:
   {:connect! (fn [])
    :disconnect! (fn [])
    :send! (fn [msg])
    :on-message! (fn [handler])}

   Default transport: WebSocket + post-connect `authenticate` handshake
   (token in message body — not query string)."
  (:require
   ["dart:async" :as async]
   ["dart:convert" :as convert]
   ["package:web_socket_channel/web_socket_channel.dart" :as ws]
   [mgl.call.config :as config]
   [mgl.call.log :as log]))

(defonce ^:private !transport (atom nil))
(defonce ^:private !handler (atom nil))
(defonce ^:private !conn
  (atom {:channel nil :subscription nil :status :disconnected :authenticated? false}))
(defonce ^:private !auth-waiter (atom nil))
(defonce ^:private !ever-authed (atom false))

(defn- kebab->snake [s]
  (.replaceAll ^String (str s) "-" "_"))

(defn- snake->kebab [s]
  (.replaceAll ^String (str s) "_" "-"))

(defn- keywordize-keys [m]
  (cond
    (map? m)
    (into {}
          (map (fn [[k v]]
                 [(if (string? k) (keyword (snake->kebab k)) k)
                  (keywordize-keys v)]))
          m)
    (sequential? m) (mapv keywordize-keys m)
    :else m))

(defn- stringify-keys [m]
  (cond
    (map? m)
    (into {}
          (map (fn [[k v]]
                 [(cond
                    (keyword? k) (kebab->snake (name k))
                    (string? k) (kebab->snake k)
                    :else (str k))
                  (stringify-keys v)]))
          m)
    (sequential? m) (mapv stringify-keys m)
    :else m))

(defn- unwrap-data [msg]
  "Flatten envelope `data` into top-level keys for session handlers."
  (let [data (:data msg)
        data (cond
               (map? data) data
               (string? data)
               (try
                 (keywordize-keys (convert/jsonDecode data))
                 (catch Exception _ {}))
               :else {})
        base (dissoc msg :data)]
    (merge data base
           (cond-> {}
             (:call-id base) (assoc :call-id (:call-id base))
             (:type base) (assoc :type (:type base))))))

(defn- normalize-type [t]
  (case t
    ("webrtc.ice_candidate" :webrtc.ice_candidate) "webrtc.ice-candidate"
    ("media.mute" :media.mute) "call.mute"
    ("media.unmute" :media.unmute) "call.unmute"
    ("media.camera_off" :media.camera_off) "call.video-off"
    ("media.camera_on" :media.camera_on) "call.video-on"
    ("call.hangup" :call.hangup) "call.ended"
    (if (keyword? t) (name t) (str t))))

(defn- complete-auth! [ok?]
  (when-let [w @!auth-waiter]
    (reset! !auth-waiter nil)
    (try
      (.complete ^async/Completer w ok?)
      (catch Exception _))))

(defn- dispatch! [raw]
  (try
    (let [msg (unwrap-data (keywordize-keys (convert/jsonDecode raw)))
          typ (normalize-type (:type msg))]
      (log/debug "signaling recv type=" typ " call-id=" (:call-id msg))
      (case typ
        ("authenticated" :authenticated)
        (do
          (swap! !conn assoc :authenticated? true :status :open)
          (reset! !ever-authed true)
          (complete-auth! true)
          (when-let [h @!handler]
            (h (assoc msg :type "authenticated"))))

        ("error" :error)
        (do
          (when (and (not (:authenticated? @!conn)) @!auth-waiter)
            (log/error "signaling auth failed: " (or (:message msg) (:code msg)))
            (complete-auth! false))
          (when-let [h @!handler]
            (h (assoc msg :type "error"))))

        (when-let [h @!handler]
          (h (assoc msg :type typ)))))
    (catch Exception e
      (log/error "signaling decode failed: " e))))

(defn- teardown-ws! [reason]
  (complete-auth! false)
  (let [{:keys [subscription channel]} @!conn]
    (when subscription
      (try (.cancel ^async/StreamSubscription subscription) (catch Exception _)))
    (when channel
      (try
        (.close (.-sink ^ws/WebSocketChannel channel))
        (catch Exception _))))
  (reset! !conn {:channel nil :subscription nil :status :disconnected :authenticated? false})
  (log/info "signaling disconnected reason=" reason))

(defn- send-raw! [msg]
  (when (= :open (:status @!conn))
    (let [^ws/WebSocketChannel channel (:channel @!conn)
          payload (convert/jsonEncode (stringify-keys msg))]
      (log/debug "signaling send type=" (:type msg) " call-id=" (:call-id msg))
      (.add (.-sink channel) payload)
      true)))

(defn- ^:async authenticate! []
  (let [token (config/get* :access-token)
        device-id (config/get* :device-id)
        reconnect? (boolean @!ever-authed)]
      (cond
         (or (nil? token) (zero? (count token)))
         (do (log/warn "no access-token; authenticate required")
             false)

         :else
         (let [waiter (async/Completer.)
               _ (reset! !auth-waiter waiter)
               sent? (send-raw!
                      {:type "authenticate"
                       :token token
                       :device-id device-id
                       :reconnect reconnect?})]
           (if-not sent?
             false
             (try
               (await (.timeout (.-future waiter) (Duration. .seconds 15)))
               (catch Exception e
                 (log/error "authenticate timeout/failed: " e)
                 (complete-auth! false)
                 false)))))))

(defn make-websocket
  "Build default WebSocket signaling transport.

   After the socket opens, sends `{type: authenticate, token, device_id}`
   and waits for `authenticated` before connect! returns true."
  []
  (let [url (config/get* :signaling-url)]
    {:connect!
     (fn ^:async []
       (cond
         (nil? url)
         (do (log/warn "no signaling-url configured") false)

         (and (= :open (:status @!conn)) (:authenticated? @!conn))
         true

         :else
         (try
           (when-not (= :disconnected (:status @!conn))
             (teardown-ws! "reconnect"))
           (swap! !conn assoc :status :connecting :authenticated? false)
           (let [channel (ws/WebSocketChannel.connect (dart:core/Uri.parse url))
                 sub (.listen (.-stream channel)
                              (fn [raw] (dispatch! raw))
                              .onError (fn [err]
                                         (log/error "signaling error: " err)
                                         (teardown-ws! (str err)))
                              .onDone (fn [] (teardown-ws! "closed")))]
             (swap! !conn assoc :channel channel :subscription sub)
             (await (.timeout (.-ready channel) (Duration. .seconds 15)))
             (swap! !conn assoc :status :open)
             (let [ok? (await (authenticate!))]
               (if ok?
                 (do (log/info "signaling connected+authenticated")
                     true)
                 (do (teardown-ws! "auth-failed")
                     false))))
           (catch Exception e
             (log/error "signaling connect failed: " e)
             (teardown-ws! (str e))
             false))))

     :disconnect!
     (fn []
       (when-not (= :disconnected (:status @!conn))
         (teardown-ws! "local")))

     :send!
     (fn [msg]
       (when (and (= :open (:status @!conn))
                  (or (:authenticated? @!conn)
                      (= "authenticate" (:type msg))))
         (send-raw! msg)))

     :on-message!
     (fn [handler]
       (reset! !handler handler)
       nil)

     :status
     (fn [] (:status @!conn))

     :authenticated?
     (fn [] (boolean (:authenticated? @!conn)))}))

(defn set-transport!
  "Install a signaling transport map (or nil)."
  [transport]
  (reset! !transport transport)
  transport)

(defn transport
  "Current transport, or nil."
  []
  @!transport)

(defn ensure-transport!
  "Use injected :signaling from config, else default WebSocket transport."
  []
  (or @!transport
      (let [injected (config/get* :signaling)
            t (or injected (make-websocket))]
        (reset! !transport t)
        t)))

(defn ^:async connect! []
  (let [t (ensure-transport!)]
    (await ((:connect! t)))))

(defn disconnect! []
  (when-let [t @!transport]
    ((:disconnect! t))))

(defn send!
  "Send a signaling message map. Returns true when handed to transport."
  [msg]
  (if-let [t @!transport]
    (boolean ((:send! t) msg))
    (do (log/warn "send! with no transport") false)))

(defn on-message!
  "Register the single global inbound message handler."
  [handler]
  (let [t (ensure-transport!)]
    ((:on-message! t) handler)))

(defn- envelope
  ([type call-id]
   {:type type :call-id call-id})
  ([type call-id data]
   (cond-> {:type type :call-id call-id}
     (and data (pos? (count data))) (assoc :data data))))

;; Convenience message builders (server protocol names)

(defn call-create [m]
  (send! (envelope "call.create"
                   (:call-id m)
                   {:callee-id (:callee-id m)
                    :callee-ids (:callee-ids m)
                    :type (or (:type m) (:media-type m) "audio")
                    :mode (or (:mode m) "direct")
                    :caller-name (:caller-name m)})))

(defn call-accept [call-id]
  (send! (envelope "call.accept" call-id)))

(defn call-reject [call-id]
  (send! (envelope "call.reject" call-id)))

(defn call-cancel [call-id]
  (send! (envelope "call.cancel" call-id)))

(defn call-end [call-id]
  (send! (envelope "call.hangup" call-id)))

(defn webrtc-offer [call-id sdp]
  (send! (envelope "webrtc.offer" call-id {:sdp sdp})))

(defn webrtc-answer [call-id sdp]
  (send! (envelope "webrtc.answer" call-id {:sdp sdp})))

(defn webrtc-ice [call-id candidate]
  (send! (envelope "webrtc.ice_candidate" call-id candidate)))

(defn media-audio [call-id enabled?]
  (send! (envelope (if enabled? "media.unmute" "media.mute") call-id)))

(defn media-video [call-id enabled?]
  (send! (envelope (if enabled? "media.camera_on" "media.camera_off") call-id)))
