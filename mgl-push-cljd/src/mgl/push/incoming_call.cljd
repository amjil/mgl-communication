(ns mgl.push.incoming-call
  "Incoming call push + Call Control helpers (mgl-call integration boundary)."
  (:require [mgl.push.events :as e]))

(def incoming-call? e/incoming-call?)
(def call-cancelled? e/call-cancelled?)
(def call-ended? e/call-ended?)
(def call-id e/call-id)

(defn call-data
  "Extract call payload map from an incoming-call DomainPushEvent."
  [event]
  (when (e/incoming-call? event)
    (e/event-data event)))

(defn call-action
  "System Call UI action: \"accepted\" | \"rejected\" | \"timeout\" | nil (ringing)."
  [event]
  (when (e/incoming-call? event)
    (let [d (e/event-data event)]
      (get d "action"))))

(defn ringing?
  [event]
  (and (e/incoming-call? event)
       (let [a (call-action event)]
         (or (nil? a) (= a "ringing")))))

(defn accepted?
  [event]
  (= "accepted" (call-action event)))

(defn rejected?
  [event]
  (= "rejected" (call-action event)))
