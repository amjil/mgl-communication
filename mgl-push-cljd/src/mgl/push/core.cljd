(ns mgl.push.core
  "Thin ClojureDart wrapper around the mgl_push Flutter package.
   Do not re-implement providers here."
  (:require
   ["package:mgl_push/mgl_push.dart" :as push]
   ["dart:async" :as async]))

(def ^:private !client (atom nil))
(def ^:private !handlers (atom {}))
(def ^:private !sub (atom nil))

(defn- ->config
  "Build a Dart MglPushConfig from a Clojure map or pass through an existing one."
  [config]
  (cond
    (dart/is? config push/MglPushConfig) config
    (map? config)
    (push/MglPushConfig.
     .serverUrl (or (:server-url config) (:serverUrl config))
     .serviceToken (or (:service-token config) (:serviceToken config))
     .appId (or (:app-id config) (:appId config))
     .registerOnInitialize
     (cond
       (contains? config :register-on-initialize) (:register-on-initialize config)
       (contains? config :registerOnInitialize) (:registerOnInitialize config)
       :else true))
    :else
    (throw (ex-info "mgl.push/create expects a map or MglPushConfig"
                    {:config config}))))

(defn create
  "Create an MglPush client.

   Config map keys (kebab-case preferred):
   - :server-url (required)
   - :service-token (required)
   - :app-id (required)
   - :register-on-initialize (optional, default true)"
  [config]
  (let [c (push/createMglPush (->config config))]
    (reset! !client c)
    c))

(defn- client!
  ([] (or @!client (throw (ex-info "Call (push/create) or (push/init!) first" {}))))
  ([c] c))

(defn init!
  "Spec-style global init. Creates client from config and initializes."
  ([config]
   (let [c (create config)]
     (.initialize ^push/MglPush c)
     c))
  ([]
   (.initialize ^push/MglPush (client!))))

(defn initialize
  ([client] (.initialize ^push/MglPush client))
  ([] (initialize (client!))))

(defn register!
  ([client] (.register ^push/MglPush client))
  ([] (register! (client!))))

(defn register
  ([client] (register! client))
  ([] (register!)))

(defn device
  ([client] (.getDevice ^push/MglPush client))
  ([] (device (client!))))

(defn unregister!
  ([client] (.unregister ^push/MglPush client))
  ([] (unregister! (client!))))

(defn unregister
  ([client] (unregister! client))
  ([] (unregister!)))

(defn set-user-id!
  ([client user-id] (.setUserId ^push/MglPush client user-id))
  ([user-id] (set-user-id! (client!) user-id)))

(defn set-user-id
  ([client user-id] (set-user-id! client user-id))
  ([user-id] (set-user-id! user-id)))

(defn clear-user-id!
  ([client] (.clearUserId ^push/MglPush client))
  ([] (clear-user-id! (client!))))

(defn clear-user-id
  ([client] (clear-user-id! client))
  ([] (clear-user-id!)))

(defn request-permission!
  ([client] (.requestPermission ^push/MglPush client))
  ([] (request-permission! (client!))))

(defn request-permission
  ([client] (request-permission! client))
  ([] (request-permission!)))

(defn capabilities
  "Returns PushCapabilities (spec §17)."
  ([client] (.getCapabilities ^push/MglPush client))
  ([] (capabilities (client!))))

(defn messages
  ([client] (.-messages ^push/MglPush client))
  ([] (messages (client!))))

(defn events
  ([client] (.-events ^push/MglPush client))
  ([] (events (client!))))

(defn- ensure-handler-sub!
  [client]
  (when-not @!sub
    (let [stream (.-events ^push/MglPush client)
          sub (.listen stream
                       (fn [event]
                         (doseq [h (vals @!handlers)]
                           (try (h event) (catch Error _)))))]
      (reset! !sub sub))))

(defn on-event
  "Register a handler for all push events with a unique key (spec §12).
   Same key overwrites the previous handler (hot-reload safe).
   Returns a zero-arg cleanup function that removes this key.

   Preferred for app-global handlers (incoming-call bridge, token, etc.).
   For Widget-scoped UI updates, prefer (events) / StreamBuilder instead."
  ([key handler]
   (if (dart/is? key push/MglPush)
     (throw (ex-info
             "on-event requires a unique key. Use (on-event key handler) or (on-event client key handler)"
             {}))
     (on-event (client!) key handler)))
  ([client key handler]
   (swap! !handlers assoc key handler)
   (ensure-handler-sub! client)
   #(swap! !handlers dissoc key)))

(defn remove-handler
  "Remove a previously registered handler by key."
  ([key]
   (swap! !handlers dissoc key)
   nil)
  ([_client key]
   (remove-handler key)))
